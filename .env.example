# PostgreSQL connection string (Vercel Postgres / Railway / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/importbih"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Resend (resend.com) — email provider
# 1. Kreiraj nalog na resend.com i generiši API ključ
# 2. Za početak koristi onboarding@resend.dev (ne treba verifikacija domena)
# 3. Kada registrujete import-bih.ba ili sličan domen, dodajte ga u Resend
#    i promijenite EMAIL_FROM na npr. "Import BiH <noreply@import-bih.ba>"
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Import BiH <onboarding@resend.dev>"
CONTACT_NOTIFY_EMAIL="kontakt@importbih.com"

# Neon direktna (ne-pooled) konekcija za migracije
DIRECT_URL=""
