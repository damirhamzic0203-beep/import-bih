// ============================================================================
// IMPORT BIH — Prisma schema (PHASE 1 core)
// Provider: PostgreSQL (Vercel/Railway). For local dev without a Postgres
// server, see README.md for the SQLite fallback instructions.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  OPERATIONS
  SALES
  CLIENT
}

enum ImportStatus {
  NEW
  UNDER_REVIEW
  SOURCING
  SUPPLIER_SELECTED
  NEGOTIATION
  QUALITY_CONTROL
  TRANSPORT_QUOTATION
  CLIENT_APPROVAL
  ORDER_CONFIRMED
  GOODS_READY
  IN_TRANSIT
  CUSTOMS
  DELIVERY
  COMPLETED
  REQUIRES_ASSESSMENT
}

enum TransportMode {
  SEA
  RAIL
  AIR
  ROAD
}

enum SupplierStatus {
  NEW
  CONTACTED
  VERIFIED
  ACTIVE
  BLOCKED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  CHANGES_REQUESTED
  DECLINED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Currency {
  EUR
  BAM
  USD
  CNY
}

// ---------------------------------------------------------------------------
// USERS & COMPANIES
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role     @default(CLIENT)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Client-only profile fields (nullable — irrelevant for staff roles)
  company       Company? @relation(fields: [companyId], references: [id])
  companyId     String?

  importRequests   ImportRequest[]  @relation("ClientRequests")
  assignedTasks    Task[]           @relation("TaskAssignee")
  messagesSent     Message[]        @relation("MessageSender")
  internalNotes    InternalNote[]   @relation("NoteAuthor")
  auditLogs        AuditLog[]       @relation("AuditActor")
  quoteVersions    QuoteVersion[]   @relation("QuoteVersionAuthor")
  notifications    Notification[]
  blogPosts        BlogPost[]

  @@index([role])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  taxId     String? // JIB / ID broj firme
  address   String?
  city      String?
  country   String   @default("Bosna i Hercegovina")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  importRequests ImportRequest[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// IMPORT REQUEST (core object of the whole platform)
// ---------------------------------------------------------------------------

model ImportRequest {
  id            String       @id @default(cuid())
  code          String       @unique // e.g. IMP-2026-000125
  status        ImportStatus @default(NEW)

  client        User         @relation("ClientRequests", fields: [clientId], references: [id])
  clientId      String
  company       Company?     @relation(fields: [companyId], references: [id])
  companyId     String?

  // STEP 1 — Product
  productName      String
  productLink      String?
  alibabaLink      String?
  link1688         String?
  madeInChinaLink  String?
  productImageUrl  String?
  productDescription String?
  category         String?
  needsSourcingHelp Boolean @default(false) // "Nemam link — pronađite proizvod za mene"

  // STEP 2 — Quantity
  quantity        Int?
  unit            String?
  estimatedPrice  Decimal?     @db.Decimal(12, 2)
  targetPrice     Decimal?     @db.Decimal(12, 2)
  moq             Int?

  // STEP 3 — Supplier
  hasOwnSupplier   Boolean @default(false)
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  supplierId       String?

  // STEP 4 — Transport
  originCity        String?
  originCountry      String   @default("China")
  readyDate          DateTime?
  estimatedWeightKg  Decimal? @db.Decimal(12, 2)
  estimatedCbm       Decimal? @db.Decimal(12, 2)
  packageCount       Int?
  unknownWeightCbm   Boolean  @default(false) // "Ne znam — izračunajte/procijenite"
  transportModes     TransportMode[]

  // STEP 5 — Delivery
  destinationCity     String?
  destinationAddress   String?
  destinationPostcode  String?
  doorToDoor           Boolean @default(false)

  // STEP 6 — Contact / notes
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  clientNote    String?

  requiresAssessment Boolean @default(false)

  hsCode   HsCode? @relation(fields: [hsCodeId], references: [id])
  hsCodeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportRequests TransportRequest[]
  quotes            Quote[]
  shipment          Shipment?
  documents         Document[]
  messages          Message[]
  tasks             Task[]
  internalNotes     InternalNote[]
  supplierQuotes    SupplierQuote[]

  @@index([status])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// SUPPLIERS (China-side CRM)
// ---------------------------------------------------------------------------

model Supplier {
  id              String         @id @default(cuid())
  companyName     String
  contactPerson   String?
  phone           String?
  email           String?
  wechat          String?
  website         String?
  alibabaUrl      String?
  url1688         String?
  country         String         @default("China")
  city            String?
  isFactory       Boolean        @default(false) // false = trading company
  categories      String[]
  moq             Int?
  rating          Int? // 1-5
  status          SupplierStatus @default(NEW)
  verificationScore Int? // 0-100
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  importRequests  ImportRequest[]
  supplierQuotes  SupplierQuote[]
  documents       Document[]

  @@index([status])
  @@index([companyName])
}

model SupplierQuote {
  id              String   @id @default(cuid())
  importRequest   ImportRequest @relation(fields: [importRequestId], references: [id])
  importRequestId String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  supplierId      String

  unitPrice       Decimal? @db.Decimal(12, 2)
  quantity        Int?
  moq             Int?
  packagingCost   Decimal? @db.Decimal(12, 2)
  toolingCost     Decimal? @db.Decimal(12, 2)
  shippingChina   Decimal? @db.Decimal(12, 2)
  inspectionCost  Decimal? @db.Decimal(12, 2)
  otherCosts      Decimal? @db.Decimal(12, 2)
  supplierTotal   Decimal? @db.Decimal(12, 2)
  currency        Currency @default(USD)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importRequestId])
}

// ---------------------------------------------------------------------------
// FORWARDERS (transport / freight CRM)
// ---------------------------------------------------------------------------

model Forwarder {
  id              String   @id @default(cuid())
  companyName     String
  contactPerson   String?
  email           String?
  phone           String?
  website         String?
  originCities    String[]
  destinationCountries String[]
  supportsSea     Boolean  @default(false)
  supportsRail    Boolean  @default(false)
  supportsAir     Boolean  @default(false)
  supportsRoad    Boolean  @default(false)
  supportsLcl     Boolean  @default(false)
  supportsFcl     Boolean  @default(false)
  supportsDoorToDoor Boolean @default(false)
  supportsCustoms Boolean  @default(false)
  supportsWarehouse Boolean @default(false)
  pricingNotes    String?
  transitTimeNote String?
  currency        Currency @default(EUR)
  rating          Int?
  internalNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forwarderQuotes ForwarderQuote[]
  transportRequests TransportRequestRecipient[]

  @@index([companyName])
}

model TransportRequest {
  id              String   @id @default(cuid())
  importRequest   ImportRequest @relation(fields: [importRequestId], references: [id])
  importRequestId String

  cargoDescription String?
  quantity         Int?
  weightKg         Decimal? @db.Decimal(12, 2)
  volumeCbm        Decimal? @db.Decimal(12, 2)
  originCity       String?
  destinationCity  String?
  readyDate        DateTime?
  requestedModes   TransportMode[]

  requiresPickupChina    Boolean @default(false)
  requiresExportCustoms  Boolean @default(false)
  requiresFreight        Boolean @default(true)
  requiresEuTransit      Boolean @default(false)
  requiresBihCustoms     Boolean @default(false)
  requiresDelivery       Boolean @default(false)

  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients      TransportRequestRecipient[]
  forwarderQuotes ForwarderQuote[]

  @@index([importRequestId])
}

model TransportRequestRecipient {
  id                 String   @id @default(cuid())
  transportRequest   TransportRequest @relation(fields: [transportRequestId], references: [id])
  transportRequestId String
  forwarder          Forwarder @relation(fields: [forwarderId], references: [id])
  forwarderId        String
  sentAt             DateTime @default(now())

  @@unique([transportRequestId, forwarderId])
}

model ForwarderQuote {
  id                 String   @id @default(cuid())
  transportRequest   TransportRequest @relation(fields: [transportRequestId], references: [id])
  transportRequestId String
  forwarder          Forwarder @relation(fields: [forwarderId], references: [id])
  forwarderId        String

  price           Decimal? @db.Decimal(12, 2)
  currency        Currency @default(EUR)
  transitDays     Int?
  validUntil      DateTime?
  includedServices String?
  excludedServices String?
  pickupCost      Decimal? @db.Decimal(12, 2)
  freightCost     Decimal? @db.Decimal(12, 2)
  customsCost     Decimal? @db.Decimal(12, 2)
  deliveryCost    Decimal? @db.Decimal(12, 2)
  insuranceCost   Decimal? @db.Decimal(12, 2)
  otherFees       Decimal? @db.Decimal(12, 2)
  totalCost       Decimal? @db.Decimal(12, 2)
  notes           String?
  attachmentUrl   String?

  isRecommended   Boolean @default(false)
  recommendReason String?
  isSelected      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transportRequestId])
}

// ---------------------------------------------------------------------------
// CLIENT QUOTES (with versioning)
// ---------------------------------------------------------------------------

model Quote {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. Q-000125
  importRequest   ImportRequest @relation(fields: [importRequestId], references: [id])
  importRequestId String

  status          QuoteStatus @default(DRAFT)

  productCost     Decimal? @db.Decimal(12, 2)
  logisticsCost   Decimal? @db.Decimal(12, 2)
  customsCost     Decimal? @db.Decimal(12, 2)
  deliveryCost    Decimal? @db.Decimal(12, 2)
  serviceCost     Decimal? @db.Decimal(12, 2)
  vatAmount       Decimal? @db.Decimal(12, 2)
  totalAmount     Decimal? @db.Decimal(12, 2)
  currency        Currency @default(EUR)

  // Internal-only figures — NEVER exposed to client-facing views/serializers
  internalCost    Decimal? @db.Decimal(12, 2)
  grossProfit     Decimal? @db.Decimal(12, 2)
  marginPct       Decimal? @db.Decimal(5, 2)

  validUntil      DateTime?
  sentAt          DateTime?
  respondedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions QuoteVersion[]
  order    Order?

  @@index([importRequestId])
  @@index([status])
}

model QuoteVersion {
  id        String   @id @default(cuid())
  quote     Quote    @relation(fields: [quoteId], references: [id])
  quoteId   String
  versionNo Int
  snapshot  Json // full quote field snapshot at time of change
  changedBy User     @relation("QuoteVersionAuthor", fields: [changedById], references: [id])
  changedById String
  changeNote String?
  createdAt DateTime @default(now())

  @@unique([quoteId, versionNo])
}

model Order {
  id        String   @id @default(cuid())
  quote     Quote    @relation(fields: [quoteId], references: [id])
  quoteId   String   @unique
  confirmedAt DateTime @default(now())
  createdAt DateTime @default(now())

  payments  Payment[]
  invoices  Invoice[]
}

// ---------------------------------------------------------------------------
// PAYMENTS / INVOICES (structure only — Phase 2 wires up a gateway)
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  currency      Currency      @default(EUR)
  dueDate       DateTime?
  status        PaymentStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       String
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId     String?
  amount        Decimal  @db.Decimal(12, 2)
  currency      Currency @default(EUR)
  paidDate      DateTime?
  method        String?
  notes         String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// SHIPMENTS
// ---------------------------------------------------------------------------

model Shipment {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. SHP-2026-000125
  importRequest   ImportRequest @relation(fields: [importRequestId], references: [id])
  importRequestId String   @unique

  carrier         String?
  containerNumber String?
  blNumber        String?
  trackingNumber  String?
  origin          String?
  destination     String?
  etd             DateTime?
  eta             DateTime?
  actualDeparture DateTime?
  actualArrival   DateTime?
  transportMode   TransportMode?
  currentLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ShipmentEvent[]
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId  String
  label       String // e.g. "Departed China", "Bosnia Customs"
  occurredAt  DateTime @default(now())
  note        String?

  @@index([shipmentId])
}

// ---------------------------------------------------------------------------
// DOCUMENTS
// ---------------------------------------------------------------------------

model Document {
  id              String   @id @default(cuid())
  importRequest   ImportRequest? @relation(fields: [importRequestId], references: [id])
  importRequestId String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  supplierId      String?

  folder      String // e.g. "01 Supplier", "05 Customs"
  fileName    String
  fileUrl     String
  mimeType    String?
  sizeBytes   Int?
  visibleToClient Boolean @default(false)

  uploadedAt DateTime @default(now())

  @@index([importRequestId])
}

// ---------------------------------------------------------------------------
// MESSAGING
// ---------------------------------------------------------------------------

model Message {
  id              String   @id @default(cuid())
  importRequest   ImportRequest @relation(fields: [importRequestId], references: [id])
  importRequestId String
  sender          User     @relation("MessageSender", fields: [senderId], references: [id])
  senderId        String
  body            String
  isInternal      Boolean  @default(false) // internal ops<->admin note vs client-visible
  attachmentUrl   String?
  createdAt       DateTime @default(now())

  @@index([importRequestId])
}

// ---------------------------------------------------------------------------
// TASKS
// ---------------------------------------------------------------------------

model Task {
  id              String       @id @default(cuid())
  importRequest   ImportRequest @relation(fields: [importRequestId], references: [id])
  importRequestId String
  title           String
  assignedTo      User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedToId    String?
  deadline        DateTime?
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(TODO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importRequestId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// INTERNAL NOTES (never shown to client)
// ---------------------------------------------------------------------------

model InternalNote {
  id              String   @id @default(cuid())
  importRequest   ImportRequest @relation(fields: [importRequestId], references: [id])
  importRequestId String
  author          User     @relation("NoteAuthor", fields: [authorId], references: [id])
  authorId        String
  body            String
  createdAt       DateTime @default(now())

  @@index([importRequestId])
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorId    String?
  action     String // e.g. "quote.updated"
  entity     String // e.g. "Quote"
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// CONTACT SUBMISSIONS
// ---------------------------------------------------------------------------

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String
  message   String
  createdAt DateTime @default(now())
}

enum ContactMessageStatus {
  NOVA
  ODGOVORENO
  ARHIVIRANO
}

model ContactMessage {
  id          String               @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String               @db.Text
  status      ContactMessageStatus @default(NOVA)
  reply       String?              @db.Text
  repliedAt   DateTime?
  repliedBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// BLOG
// ---------------------------------------------------------------------------

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String?
  featuredImage   String?
  seoTitle        String?
  metaDescription String?
  categories      String[]
  tags            String[]
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  authorId        String?
  author          User?     @relation(fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// HS CODES (customs tariff database — admin-managed, never auto-generated)
// ---------------------------------------------------------------------------

model HsCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  dutyRate    Decimal  @db.Decimal(5, 2)
  notes       String?
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  importRequests ImportRequest[]
}

// ---------------------------------------------------------------------------
// EXCHANGE RATES
// ---------------------------------------------------------------------------

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(10, 6)
  updatedAt    DateTime @updatedAt
  updatedById  String?

  @@unique([fromCurrency, toCurrency])
}
